# Choose one: local, supabase, firebase
# local = browser localStorage only; no cross-device sync.
VITE_SYNC_PROVIDER=local

# Supabase config. Use these if VITE_SYNC_PROVIDER=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Firebase config. Use these if VITE_SYNC_PROVIDER=firebase
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Bootstrap admin emails, comma separated. These emails can see the admin panel.
VITE_ADMIN_EMAILS=you@example.com

# Bootstrap teacher emails, comma separated. These emails can see the teacher dashboard.
VITE_TEACHER_EMAILS=teacher@example.com
